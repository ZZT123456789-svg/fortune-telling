# ===== 数据服务（必填）=====
# Supabase 项目 URL，例如 https://项目编号.supabase.co
DATA_API_URL=

# Supabase Dashboard → Project Settings → API → service_role
# 这是服务端 API 密钥，不是数据库密码；不要放进浏览器代码。
DATA_SERVICE_KEY=

# 至少 32 个字符的随机字符串，用于签名匿名身份 Cookie。
VISITOR_SIGNING_KEY=

# ===== 支付（必填）=====
ZPAY_PID=
ZPAY_KEY=
APP_URL=https://daowenai.icu

# ===== AI（必填）=====
DEEPSEEK_API_KEY=

# ===== 可选兼容变量 =====
# 若部署平台仍使用旧变量名，代码会兼容读取它们。
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
