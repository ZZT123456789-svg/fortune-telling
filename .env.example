# ===== 必填 =====
# Supabase 服务端密钥（Supabase Dashboard → Project Settings → API → service_role）
SUPABASE_SERVICE_ROLE_KEY=

# ZPay 支付商户 ID 和密钥（ZPay 商户后台获取）
ZPAY_PID=
ZPAY_KEY=

# DeepSeek AI API 密钥（DeepSeek 开放平台获取）
DEEPSEEK_API_KEY=

# ===== 可选 =====
# Supabase 项目 URL（不设则使用代码内的 fallback）
# SUPABASE_URL=https://ebdnkgfilnvfkkdvqrzu.supabase.co

# Supabase 匿名密钥（不设则使用代码内的 fallback）
# SUPABASE_ANON_KEY=

# DeepSeek 模型名（默认 deepseek-v4-flash）
# DEEPSEEK_MODEL=deepseek-v4-flash

# 网站地址（默认 https://daowenai.icu），用于支付回调 URL
# APP_URL=https://daowenai.icu
